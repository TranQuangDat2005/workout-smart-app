# ============================================================
# WorkoutSmartApp Backend — Environment Configuration (template)
# Sao chép file này thành `.env` và điền giá trị thật của bạn.
# KHÔNG commit `.env` (đã nằm trong .gitignore — constitution §5).
# ============================================================

# --- Database PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/workoutDB
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# --- JWT (BẮT BUỘC — app sẽ fail khi boot nếu thiếu) ---
# Sinh secret ngẫu nhiên ≥ 32 bytes, ví dụ: openssl rand -base64 48
JWT_SECRET=replace_with_random_secret_at_least_32_bytes

# --- Email ---
# log = ghi OTP ra log (dev) | sendgrid = gửi email thật (production)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@workoutsmart.app
# Chỉ cần khi EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# --- Server ---
# SERVER_PORT=8080
