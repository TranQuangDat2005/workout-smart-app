# Sao chép file này thành .env.docker rồi điền giá trị thật.
# KHÔNG commit .env.docker
#
# PowerShell:
#   Copy-Item .env.docker.example .env.docker

# Bắt buộc — backend không khởi động nếu thiếu (>= 32 ký tự ngẫu nhiên)
JWT_SECRET=replace_with_random_secret_at_least_32_bytes

# Mật khẩu PostgreSQL trong container (mặc định: postgres)
POSTGRES_PASSWORD=postgres
